# Copy this file to .env and fill in real values. Never commit .env itself.

# Same MySQL database the PHP app uses
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=if0_40252865_user_db

# Where trained model artifacts are saved/loaded from
MODEL_DIR=./models_store

# Sentence-BERT model name (downloaded from HuggingFace on first run)
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# API server
API_HOST=0.0.0.0
API_PORT=8000

